{
  "schema": "trillionnium.denominator-review-policy.v1",
  "project_id": "trillionnium-game",
  "required_denominators": [
    "DEN-SOURCE", "DEN-API", "DEN-RTAPI", "DEN-CONSOLE", "DEN-RUNTIME",
    "DEN-CONFIG", "DEN-CLI", "DEN-DB", "DEN-DATA", "DEN-METRICS",
    "DEN-OPS", "DEN-PROVIDERS", "DEN-IAP", "DEN-SDK"
  ],
  "classifications": ["mandatory", "optional-profile", "versioned-exclusion"],
  "owner_roles": [
    "governance", "protocol", "runtime", "identity", "database", "realtime",
    "iap", "console", "security", "sre", "sdk", "legal"
  ],
  "minimum_reviewers": 2,
  "minimum_exclusion_reviewers": 2,
  "evidence_roots": ["docs/evidence", "manifests/evidence"],
  "adr_roots": ["docs/adr"],
  "self_approval_allowed": false,
  "remote_evidence_required_for_lock": true,
  "global_sg1_requires_independent_gate_review": true
}
