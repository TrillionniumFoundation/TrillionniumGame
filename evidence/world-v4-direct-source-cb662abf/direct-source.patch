-#[derive(Default)]
-struct TerminalOrphanReconciliationReport {
-    scanned: u64,
-    recovered: u64,
-    failed_closed: u64,
-    pending: u64,
-    failed: u64,
-    terminal_ack_gaps: u64,
-    quarantined_without_high_water: u64,
-}
