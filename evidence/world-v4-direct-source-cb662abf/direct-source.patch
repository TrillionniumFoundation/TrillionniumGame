-        .try_get::<Option<i64>, _>("terminal_stage_match_revision")
-        .map_err(|error| error.to_string())?;
-    if simulation_value.is_none()
-        && result_value.is_none()
-        && result_hash.is_none()
-        && snapshot_hash.is_none()
-        && authoritative_tick.is_none()
