-fn match_actor_registry_coverage_is_operational(
-    active_matches: i64,
-    running_match_actors: usize,
-    total_match_actors: usize,
-    initializing_match_actors: usize,
-) -> bool {
-    usize::try_from(active_matches).ok().is_some_and(|active| {
