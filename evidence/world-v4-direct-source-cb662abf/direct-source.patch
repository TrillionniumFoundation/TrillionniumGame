-        final_phase: "failed_closed",
-        waiting_db_only,
-        hot_witness_present_before,
-        cold_witness_sealed,
-        local_marker_state,
-        legacy_adoption,
-        adoption_contract: legacy_adoption.then_some("legacy_pre_v13_adoption_v1"),
-    })
-}
