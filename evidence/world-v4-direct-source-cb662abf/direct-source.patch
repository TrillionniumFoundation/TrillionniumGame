-        }
-        u32::from_str_radix(part, 16).ok()
-    }
-
-    let (high, low) = value.split_once('/')?;
-    if low.contains('/') {
-        return None;
-    }
-    let high = parse_canonical_hex_part(high)?;
-    let low = parse_canonical_hex_part(low)?;
-    Some((u64::from(high) << 32) | u64::from(low))
-}
