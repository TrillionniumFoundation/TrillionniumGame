# Copy to a non-versioned file and replace every value. Never deploy these
# placeholders. The Compose model deliberately refuses to start if any
# required variable is absent.
TRNM_NAKAMA_COMPOSE_PROJECT=trillionnium-nakama-p0-local
TRNM_NAKAMA_HTTP_PORT=0
TRNM_NAKAMA_IMAGE=trillionnium-nakama:p0-local
# The Compose/Nakama secrets below use the URL-safe alphabet
# A-Z a-z 0-9 . _ ~ - and contain at least 32 characters.
TRNM_NAKAMA_DB_PASSWORD=replace-with-a-random-database-password

NAKAMA_SERVER_KEY=replace-with-a-random-server-key
NAKAMA_SESSION_ENCRYPTION_KEY=replace-with-a-random-session-key
NAKAMA_SESSION_REFRESH_ENCRYPTION_KEY=replace-with-a-random-refresh-key
NAKAMA_RUNTIME_HTTP_KEY=replace-with-a-random-runtime-http-key
NAKAMA_CONSOLE_PASSWORD=replace-with-a-random-console-password
NAKAMA_CONSOLE_SIGNING_KEY=replace-with-a-random-console-signing-key

# JSON object of Hepta issuer key id to base64/raw Ed25519 public key.
TRNM_HEPTA_ISSUER_KEYS={"replace-hepta-key-id":"replace-base64-public-key"}
TRNM_NAKAMA_AUTHORITY_KEY_ID=replace-nakama-key-id
# Base64/raw 32-byte Ed25519 seed or 64-byte private key.
TRNM_NAKAMA_AUTHORITY_PRIVATE_KEY=replace-base64-private-seed
TRNM_NAKAMA_OPERATOR_TOKEN=replace-with-at-least-32-random-bytes
TRNM_NAKAMA_MATCH_TICK_RATE=5

# Canonical Rust source configuration is separate from the Compose/Nakama names.
# Disabled is the default when no profile material is supplied. This explicit
# selection must not be combined with either profile's keys or TTLs.
TRNM_SERVER_AUTH_MODE=disabled

# Durable-family source example (choose this profile instead of disabled).
# TRNM_SERVER_AUTH_MODE=durable-family
# TRNM_SERVER_SESSION_AUTH_ISSUER=operator-supplied-issuer
# TRNM_SERVER_SESSION_AUTH_AUDIENCE=operator-supplied-audience
# TRNM_SERVER_SESSION_AUTH_EPOCH=1
# TRNM_SERVER_SESSION_AUTH_KEY_HEX=operator-supplied-64-lowercase-hex-secret
# Without AUTH_MODE, legacy Durable opt-in additionally requires:
# TRNM_SERVER_SESSION_AUTH_ENABLED=true

# Legacy source example ONLY: AccountsV5 capture gate is false. Parsing this
# selection does not authorize migration, account SQL or any Legacy listener.
# Choose it instead of disabled/Durable; omit ALL SESSION_AUTH_* variables.
# Keys have no default: exact untrimmed UTF-8, 1..4096 bytes, no Durable 32-byte
# minimum. Distinct access/refresh keys are inherited local policy, not parity.
# Replace every illustrative value. TTLs are explicitly supplied positive i64;
# actual local duration maxima are access 4611686018 / refresh 9223372036 seconds.
# TRNM_SERVER_AUTH_MODE=nakama-legacy
# TRNM_SERVER_SCHEMA_TARGET=nakama-accounts-v5
# TRNM_SERVER_LEGACY_SERVER_KEY=operator-supplied-server-secret
# TRNM_SERVER_LEGACY_ACCESS_KEY=operator-supplied-access-secret
# TRNM_SERVER_LEGACY_REFRESH_KEY=operator-supplied-refresh-secret
# TRNM_SERVER_LEGACY_ACCESS_TTL_SECONDS=3600
# TRNM_SERVER_LEGACY_REFRESH_TTL_SECONDS=86400
# TRNM_SERVER_LEGACY_SINGLE_SESSION=false
# Canonical HTTP bind is TRNM_SERVER_BIND (not TRNM_SERVER_HTTP_BIND).
# Supply all other canonical startup fields using docs/DEVELOPMENT.md.
# check-config remains pure; source wiring grants no native HTTP/parity credit.
