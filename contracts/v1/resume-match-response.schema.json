{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TrillionniumFoundation/Trillionnium-Nakama/contracts/v1/resume-match-response.schema.json",
  "title": "ResumeMatchResponseV1",
  "description": "A live match returns a runtime locator; an already completed match returns immutable evidence.",
  "oneOf": [
    {"$ref": "#/$defs/matchRuntime"},
    {"$ref": "#/$defs/evidence"}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000]+$"},
    "logicalMatchId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "matchRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "logical_match_id", "external_match_id", "runtime_generation",
        "status", "match_version"
      ],
      "properties": {
        "schema": {"const": "trnm.nakama.match-runtime.v1"},
        "logical_match_id": {"$ref": "#/$defs/logicalMatchId"},
        "external_match_id": {"$ref": "#/$defs/id"},
        "runtime_generation": {"type": "integer", "minimum": 1},
        "status": {"enum": ["created", "waiting", "ready", "active"]},
        "match_version": {"type": "integer", "minimum": 1}
      }
    },
    "matchCompleted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "commitment_id", "match_id", "challenge_id", "terminal_facts", "event_count",
        "event_root", "roster_root", "ruleset_hash", "dataset_hash",
        "challenge_snapshot_hash", "archive_hash", "completed_at_unix",
        "authority_key_id", "signature"
      ],
      "properties": {
        "schema": {"const": "trnm.match.completed.v1"},
        "commitment_id": {"$ref": "#/$defs/digest"},
        "match_id": {"$ref": "#/$defs/logicalMatchId"},
        "challenge_id": {"$ref": "#/$defs/id"},
        "terminal_facts": {"$ref": "#/$defs/terminalFacts"},
        "event_count": {"type": "integer", "minimum": 1},
        "event_root": {"$ref": "#/$defs/digest"},
        "roster_root": {"$ref": "#/$defs/digest"},
        "ruleset_hash": {"$ref": "#/$defs/digest"},
        "dataset_hash": {"$ref": "#/$defs/digest"},
        "challenge_snapshot_hash": {"$ref": "#/$defs/digest"},
        "archive_hash": {"$ref": "#/$defs/digest"},
        "completed_at_unix": {"type": "integer", "minimum": 0},
        "authority_key_id": {"$ref": "#/$defs/id"},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
      }
    },
    "terminalFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_code", "winner_slot", "outcome_hash"],
      "properties": {
        "result_code": {"$ref": "#/$defs/id"},
        "winner_slot": {"enum": [0, 1, 2]},
        "outcome_hash": {"$ref": "#/$defs/digest"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "logical_match_id", "runtime_generation", "completion",
        "authority_public_key_base64"
      ],
      "properties": {
        "schema": {"const": "trnm.nakama.evidence.v1"},
        "logical_match_id": {"$ref": "#/$defs/logicalMatchId"},
        "external_match_id": {"$ref": "#/$defs/id"},
        "runtime_generation": {"type": "integer", "minimum": 1},
        "completion": {"$ref": "#/$defs/matchCompleted"},
        "authority_public_key_base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$"}
      }
    }
  }
}
