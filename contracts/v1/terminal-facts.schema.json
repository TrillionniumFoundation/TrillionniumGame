{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TrillionniumFoundation/Trillionnium-Nakama/contracts/v1/terminal-facts.schema.json",
  "title": "TerminalFactsV1",
  "description": "Operator-supplied terminal facts. Derived roots are deliberately absent to avoid event-root self-reference.",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_code", "winner_slot", "outcome_hash"],
  "properties": {
    "result_code": {"$ref": "#/$defs/id"},
    "winner_slot": {"enum": [0, 1, 2]},
    "outcome_hash": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000]+$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
