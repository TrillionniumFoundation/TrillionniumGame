{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TrillionniumFoundation/Trillionnium-Nakama/contracts/v1/readiness-response.schema.json",
  "title": "ReadinessResponseV1",
  "description": "Configuration, database, and server-owned storage readiness. Failed checks remain a successful RPC transport response.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ready", "checks"],
  "properties": {
    "schema": {"const": "trnm.nakama.readiness.v1"},
    "ready": {"type": "boolean"},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration", "database", "storage"],
      "properties": {
        "configuration": {"enum": ["ok", "error"]},
        "database": {"enum": ["ok", "error"]},
        "storage": {"enum": ["ok", "error"]}
      }
    },
    "reason": {"$ref": "#/$defs/reason"}
  },
  "oneOf": [
    {
      "properties": {
        "ready": {"const": true},
        "checks": {
          "properties": {
            "configuration": {"const": "ok"},
            "database": {"const": "ok"},
            "storage": {"const": "ok"}
          }
        }
      },
      "not": {"required": ["reason"]}
    },
    {
      "properties": {"ready": {"const": false}},
      "required": ["reason"],
      "anyOf": [
        {"properties": {"checks": {"properties": {"configuration": {"const": "error"}}}}},
        {"properties": {"checks": {"properties": {"database": {"const": "error"}}}}},
        {"properties": {"checks": {"properties": {"storage": {"const": "error"}}}}}
      ]
    }
  ],
  "$defs": {
    "reason": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000]+$"}
  }
}
