{
  "schema": "trillionnium.persistence-vectors.v1",
  "project_id": "trillionnium-game",
  "status": "source-level-candidate",
  "cases": [
    {
      "id": "commit-advances-revision-event-and-outbox",
      "operations": [
        {"op": "bootstrap", "entity": "01", "generation": 1, "state": "63"},
        {"op": "commit", "command": "01", "fingerprint": "01", "expected_revision": 0, "generation": 1, "state": "0b", "events": ["01"], "outbox": ["01"]}
      ],
      "expect": {"revision": 1, "last_event_sequence": 1, "event_count": 1, "outbox_pending": ["01"]}
    },
    {
      "id": "exact-duplicate-is-idempotent",
      "operations": [
        {"op": "bootstrap", "entity": "01", "generation": 1, "state": "63"},
        {"op": "commit", "command": "01", "fingerprint": "01", "expected_revision": 0, "generation": 1, "state": "0b", "events": ["01"], "outbox": ["01"]},
        {"op": "duplicate", "command": "01", "fingerprint": "01"}
      ],
      "expect": {"revision": 1, "duplicate_revision": 1, "event_count": 1}
    },
    {
      "id": "same-command-different-fingerprint-conflicts",
      "operations": [
        {"op": "bootstrap", "entity": "01", "generation": 1, "state": "63"},
        {"op": "commit", "command": "01", "fingerprint": "01", "expected_revision": 0, "generation": 1, "state": "0b", "events": ["01"], "outbox": ["01"]},
        {"op": "duplicate", "command": "01", "fingerprint": "58"}
      ],
      "expect_error": "command_id_conflict"
    },
    {
      "id": "concurrent-commit-fences-stale-revision",
      "operations": [
        {"op": "bootstrap", "entity": "01", "generation": 1, "state": "63"},
        {"op": "commit", "command": "01", "fingerprint": "01", "expected_revision": 0, "generation": 1, "state": "0b", "events": ["01"], "outbox": ["01"]},
        {"op": "commit", "command": "02", "fingerprint": "02", "expected_revision": 0, "generation": 1, "state": "0c", "events": ["02"], "outbox": ["02"]}
      ],
      "expect_error": "entity_revision_mismatch"
    },
    {
      "id": "takeover-fences-prior-generation",
      "operations": [
        {"op": "bootstrap", "entity": "01", "generation": 1, "state": "63"},
        {"op": "takeover", "expected_generation": 1},
        {"op": "commit", "command": "01", "fingerprint": "01", "expected_revision": 0, "generation": 1, "state": "0b", "events": ["01"], "outbox": ["01"]}
      ],
      "expect_error": "authority_generation_mismatch"
    },
    {
      "id": "outbox-lease-generation-fences-stale-worker",
      "operations": [
        {"op": "bootstrap", "entity": "01", "generation": 1, "state": "63"},
        {"op": "commit", "command": "01", "fingerprint": "01", "expected_revision": 0, "generation": 1, "state": "0b", "events": ["01"], "outbox": ["01"]},
        {"op": "lease", "intent": "01", "owner": "01"},
        {"op": "retry", "intent": "01", "owner": "01", "lease_generation": 1},
        {"op": "lease", "intent": "01", "owner": "02"},
        {"op": "apply", "intent": "01", "owner": "01", "lease_generation": 1, "receipt": "46"}
      ],
      "expect_error": "outbox_lease_mismatch"
    }
  ],
