      "nakama_exact_condition_observes_the_preceding_same_key_insert",
      "nakama_policy_is_homogeneous_and_internal_mixed_policy_remains_distinct",
      "nakama_sorted_candidate_preserves_input_ack_ordinals_and_projected_witnesses",
      "nakama_step_acl_occ_and_insert_only_failures_restore_the_whole_model",
      "nakama_three_server_writes_bypass_step_acl_without_collapsing_acks",
      "nakama_two_client_writes_keep_occurrence_receipts_and_last_step_state",
      "thirteen_occurrences_follow_observed_go_order_without_reordering_acks"
    ],
    "max_operations": 100,
    "owner_order": "canonical-user-id",
    "receipt_order": "original-input-ordinal",
    "typed_mixed_duplicate_policy": "reject",
    "scope": "Pure identity/projection model and pinned Go 1.26.5 ordinal permutation; native SQL, timestamps, hooks and index effects require separate profile qualification.",
    "open_boundaries": [
      "Nakama write pgx.Batch drains later queued SQL before returning an earlier ACL rejection; this sequential source path may reject before that drain.",
      "Runtime raw OwnerID representations, pointer aliases, native lock schedules, hooks, indexes and complete gateway/SDK differential remain open."
    ],
