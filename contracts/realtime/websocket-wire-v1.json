{
  "schema": "trillionnium.websocket-wire.v1",
  "project_id": "trillionnium-game",
  "status": "source-candidate",
  "crate": "crates/trnm-realtime-wire",
  "profile": "single-frame-no-extension-source-slice",
  "maximum_payload_bytes": 131072,
  "client_requirements": [
    "FIN is set",
    "RSV1/RSV2/RSV3 are zero",
    "client mask bit is set",
    "payload length uses canonical encoding",
    "text payload is valid UTF-8",
    "control payload is at most 125 bytes",
    "close payload length is zero or at least two",
    "close code is valid and close reason is UTF-8"
  ],
  "negotiated_encodings": {
    "json": "text opcode",
    "protobuf": "binary opcode"
  },
  "server_requirements": [
    "server frames are unmasked",
    "server payload length uses minimal encoding",
    "the same payload and control bounds apply"
  ],
  "not_implemented": [
    "HTTP upgrade and Sec-WebSocket-Accept",
    "origin and protocol negotiation",
    "fragment reassembly",
    "permessage-deflate or any extension",
    "connection actor and bounded writer queue",
    "heartbeat and idle timeout",
    "session revocation and disconnect fanout",
    "reconnect cursor and missed-event recovery",
    "distributed route registry and cross-node fanout",
    "official Nakama realtime differential"
  ],
  "gap_ids": ["GAP-P0-SERVER-001"],
  "claims": {
    "source_candidate": true,
    "frame_boundary_defined": true,
    "websocket_server_implemented": false,
    "realtime_wire_compatible": false,
    "multi_node_verified": false,
    "production_ready": false
  }
}
