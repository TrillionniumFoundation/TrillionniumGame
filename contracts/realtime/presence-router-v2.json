{
  "schema": "trillionnium.game.presence-router.v2",
  "version": 2,
  "canonical_crate": "crates/trnm-presence-router-v2",
  "identity": {
    "connection_scope": ["node_id", "connection_id"],
    "generation_minimum": 1,
    "generation_high_water_persists_without_active_streams": true,
    "identity_bound_for_entire_generation": [
      "user_id",
      "session_id",
      "username"
    ],
    "identity_replacement_requires_strictly_higher_generation": true
  },
  "stream_key": {
    "fields": ["mode", "subject", "subcontext", "label"],
    "mode_minimum": 1,
    "subject_bytes": 16,
    "subcontext_bytes": 16,
    "label_max_bytes": 256
  },
  "validated_limits": {
    "connection_id_max_bytes": 128,
    "node_id_max_bytes": 128,
    "user_id_max_bytes": 128,
    "session_id_max_bytes": 128,
    "username_max_bytes": 256,
    "status_max_bytes": 512,
    "control_characters": "rejected"
  },
  "public_mutation_apis": {
    "join_presence": "JoinPresenceRequest",
    "update_presence": "UpdatePresenceRequest",
    "leave_presence": "LeavePresenceRequest",
    "remove_connection": "RemoveConnectionRequest"
  },
  "join_semantics": {
    "first_generation": "bind_generation_identity_and_join",
    "lower_generation": "reject_stale_without_state_change",
    "same_generation_same_identity_same_record": "idempotent",
    "same_generation_same_identity_changed_status": "update",
    "same_generation_different_identity": "reject_identity_conflict_without_state_change",
    "higher_generation": "atomically_retire_all_old_streams_bind_new_identity_and_join"
  },
  "non_join_semantics": {
    "generation_absent": "reject_generation_not_established",
    "lower_generation": "reject_stale_without_state_change",
    "higher_generation": "reject_generation_ahead_without_state_change",
    "exact_generation": "apply_operation"
  },
  "visibility_semantics": {
    "visible_join": "public_join",
    "visible_update": "public_update",
    "visible_leave": "public_leave",
    "visible_to_hidden": "public_leave",
    "hidden_to_visible": "public_join",
    "hidden_to_hidden": "private_change_only",
    "hidden_join_or_leave": "private_change_only"
  },
  "delta_contract": {
    "applied_revision": "strictly_monotonic_u64",
    "idempotent_revision": null,
    "public_collections": ["joins", "updates", "leaves"],
    "private_counter": "hidden_changes",
    "error_advances_revision": false
  },
  "snapshot_contract": {
    "public_only_excludes_hidden": true,
    "include_hidden_includes_all": true,
    "deterministic_order": [
      "session_id",
      "node_id",
      "connection_id"
    ]
  },
  "forbidden": [
    "positional_join_api_with_many_arguments",
    "same_generation_identity_replacement",
    "identity_reset_after_last_leave",
    "identity_reset_after_remove_connection",
    "update_establishes_generation",
    "leave_establishes_generation",
    "remove_establishes_generation",
    "partial_generation_replacement",
    "stale_mutation_advances_revision",
    "hidden_record_in_public_snapshot",
    "nondeterministic_snapshot_order"
  ],
  "evidence": {
    "black_box_tests": "crates/trnm-presence-router-v2/tests/black_box.rs",
    "deterministic_vector": "crates/trnm-presence-router-v2/examples/vector.rs",
    "python_reference": "scripts/test-presence-router-v2.py",
    "static_contract_verifier": "scripts/verify-presence-router-v2.py"
  },
  "compatibility": {
    "nakama_presence_wire_vectors_frozen": false,
    "nakama_hidden_presence_semantics_verified": false,
    "distributed_route_registry_integrated": false,
    "multi_node_reconnect_cursor_verified": false
  },
  "maturity": {
    "source_contract": true,
    "rust_black_box_gate": false,
    "cross_implementation_vector_gate": false,
    "distributed_fault_matrix": false,
    "production_ready": false
  }
}
