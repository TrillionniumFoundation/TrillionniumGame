{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TrillionniumFoundation/TrillionniumGame/contracts/world-command-rpc-v1/status-response.schema.json",
  "title": "TrillionniumGame World command status response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "logical_match_id",
    "status",
    "cutover_authorized",
    "public_online_enabled",
    "public_player_market_enabled"
  ],
  "properties": {
    "schema": {"const": "trnm.game.world-command-status-response.v1"},
    "logical_match_id": {"$ref": "#/$defs/logicalMatchId"},
    "status": {"$ref": "#/$defs/status"},
    "latest_accepted_receipt": {"$ref": "#/$defs/latestReceipt"},
    "cutover_authorized": {"const": false},
    "public_online_enabled": {"const": false},
    "public_player_market_enabled": {"const": false}
  },
  "$defs": {
    "logicalMatchId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "hex64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:/+@-]{1,160}$"
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "pending_reservations",
        "retired_reservations",
        "receipts",
        "total_attempts",
        "oldest_pending_age_seconds",
        "state_revision",
        "state_hash",
        "tick",
        "match_version",
        "next_global_event_sequence"
      ],
      "properties": {
        "schema": {"const": "trnm.nakama.world-command-status.v1"},
        "pending_reservations": {"type": "integer", "minimum": 0},
        "retired_reservations": {"type": "integer", "minimum": 0},
        "receipts": {"type": "integer", "minimum": 0},
        "total_attempts": {"type": "integer", "minimum": 0},
        "oldest_pending_age_seconds": {"type": "integer", "minimum": 0},
        "state_revision": {"type": "integer", "minimum": 1},
        "state_hash": {"$ref": "#/$defs/hex64"},
        "tick": {"type": "integer", "minimum": 0},
        "match_version": {"type": "integer", "minimum": 1},
        "next_global_event_sequence": {"type": "integer", "minimum": 1}
      }
    },
    "latestReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_command_id",
        "generation",
        "event_sequence",
        "match_version",
        "state_revision",
        "state_hash",
        "tick",
        "request_hash",
        "transition_id",
        "world_outcome_hash",
        "world_transition_hash"
      ],
      "properties": {
        "client_command_id": {"$ref": "#/$defs/identifier"},
        "generation": {"type": "integer", "minimum": 1},
        "event_sequence": {"type": "integer", "minimum": 1},
        "match_version": {"type": "integer", "minimum": 1},
        "state_revision": {"type": "integer", "minimum": 1},
        "state_hash": {"$ref": "#/$defs/hex64"},
        "tick": {"type": "integer", "minimum": 0},
        "request_hash": {"$ref": "#/$defs/hex64"},
        "transition_id": {"$ref": "#/$defs/identifier"},
        "world_outcome_hash": {"$ref": "#/$defs/hex64"},
        "world_transition_hash": {"$ref": "#/$defs/hex64"}
      }
    }
  }
}
