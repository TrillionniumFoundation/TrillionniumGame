{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TrillionniumFoundation/TrillionniumGame/contracts/world-command-rpc-v1/ready-response.schema.json",
  "title": "TrillionniumGame World command readiness response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "ready",
    "external_execution_under_lock",
    "cutover_authorized",
    "public_online_enabled",
    "public_player_market_enabled"
  ],
  "properties": {
    "schema": {"const": "trnm.game.world-command-ready.v1"},
    "profile": {"enum": ["legacy_direct", "world_transition_v1"]},
    "ready": {"type": "boolean"},
    "endpoint_host": {"type": "string", "minLength": 1, "maxLength": 253},
    "endpoint_path": {"type": "string", "minLength": 1, "maxLength": 2048},
    "error": {"type": "string", "minLength": 1, "maxLength": 4096},
    "external_execution_under_lock": {"const": false},
    "cutover_authorized": {"const": false},
    "public_online_enabled": {"const": false},
    "public_player_market_enabled": {"const": false}
  }
}
