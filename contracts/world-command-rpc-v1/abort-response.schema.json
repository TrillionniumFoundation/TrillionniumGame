{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TrillionniumFoundation/TrillionniumGame/contracts/world-command-rpc-v1/abort-response.schema.json",
  "title": "TrillionniumGame World command abort response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "logical_match_id",
    "client_command_id",
    "generation",
    "status",
    "cutover_authorized",
    "public_online_enabled",
    "public_player_market_enabled"
  ],
  "properties": {
    "schema": {"const": "trnm.game.world-command-abort-response.v1"},
    "logical_match_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "client_command_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:/+@-]{1,160}$"
    },
    "generation": {"type": "integer", "minimum": 1},
    "status": {"const": "retired"},
    "cutover_authorized": {"const": false},
    "public_online_enabled": {"const": false},
    "public_player_market_enabled": {"const": false}
  }
}
