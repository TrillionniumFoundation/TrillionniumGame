{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TrillionniumFoundation/TrillionniumGame/contracts/world-command-rpc-v1/abort-request.schema.json",
  "title": "TrillionniumGame World command abort request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operator_token",
    "logical_match_id",
    "client_command_id",
    "generation",
    "reason"
  ],
  "properties": {
    "schema": {"const": "trnm.game.world-command-abort-request.v1"},
    "operator_token": {"type": "string", "minLength": 32, "maxLength": 4096},
    "logical_match_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "client_command_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:/+@-]{1,160}$"
    },
    "generation": {"type": "integer", "minimum": 1},
    "reason": {"type": "string", "minLength": 1, "maxLength": 256}
  }
}
