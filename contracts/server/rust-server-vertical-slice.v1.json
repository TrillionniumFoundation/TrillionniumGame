{
  "schema": "trillionnium.rust-server-vertical-slice.v1",
  "project_id": "trillionnium-game",
  "contract_version": 2,
  "status": "source-candidate",
  "crate": "crates/trnm-server",
  "binary": "trnm-server-composition-candidate",
  "runtime_profile": "isolated-postgresql-grpc-realtime-composition-source",
  "configuration": {
    "environment": [
      "TRNM_SERVER_HTTP_BIND",
      "TRNM_SERVER_GRPC_BIND",
      "TRNM_SERVER_DATABASE_URL",
      "TRNM_SERVER_DATABASE_PROFILE",
      "TRNM_SERVER_WORKERS",
      "TRNM_SERVER_QUEUE_CAPACITY",
      "TRNM_SERVER_MAX_HEADER_BYTES",
      "TRNM_SERVER_MAX_BODY_BYTES",
      "TRNM_SERVER_MAX_WEBSOCKET_FRAME_BYTES",
      "TRNM_SERVER_MAX_WEBSOCKET_MESSAGES",
      "TRNM_SERVER_ADMIN_TOKEN",
      "TRNM_SERVER_ACCESS_TOKEN_PUBLIC_KEY"
    ],
    "cli_commands": [
      "check-config",
      "migrate",
      "serve"
    ],
    "bounds": {
      "listener_workers": true,
      "accepted_connection_queue": true,
      "header_and_body_bytes": true,
      "socket_deadlines": true,
      "websocket_frames_and_messages": true,
      "database_pool_and_acquisition": true,
      "retry_attempts_and_elapsed_time": true
    }
  },
  "implemented_routes": [
    {
      "method": "GET",
      "path": "/healthz",
      "classification": "liveness-source"
    },
    {
      "method": "GET",
      "path": "/readyz",
      "classification": "readiness-source"
    },
    {
      "method": "GET",
      "path": "/metrics",
      "classification": "redacted-metrics-source"
    },
    {
      "method": "POST",
      "path": "/-/drain",
      "classification": "authenticated-control-source"
    },
    {
      "method": "POST",
      "path": "/v1/authority/bootstrap",
      "classification": "internal-json-source"
    },
    {
      "method": "POST",
      "path": "/v1/authority/commit",
      "classification": "internal-json-source"
    },
    {
      "method": "GET",
      "path": "/v1/session/me",
      "classification": "session-source"
    },
    {
      "method": "POST",
      "path": "/v1/session/refresh",
      "classification": "session-source"
    },
    {
      "method": "POST",
      "path": "/v1/session/logout",
      "classification": "session-source"
    }
  ],
  "implemented_invariants": [
    "bounded accepted-connection queue and fixed listener workers",
    "bounded parser frame body message pool retry and elapsed budgets",
    "explicit readiness shared drain and admitted-operation accounting",
    "PostgreSQL entity revision and authority-generation fencing",
    "command fingerprint idempotency and exact duplicate receipt replay",
    "response construction after durable commit or durable receipt load",
    "session family generation access-token and refresh-replay checks",
    "typed public error redaction",
    "generated gRPC Healthcheck and bounded WebSocket candidate adapters"
  ],
  "required_next_adapters": [
    "atomic removal of the persistence-owned duplicate process entry point",
    "complete official Nakama HTTP gRPC gateway and RTAPI mappings",
    "complete official SDK black-box differential",
    "durable outbox external delivery and reconciliation evidence",
    "distributed route ownership node-loss partition and takeover",
    "accepted PostgreSQL CockroachDB backup PITR migration and ambiguity evidence",
    "KMS HSM provider IAP Console and runtime surfaces",
    "capacity rolling upgrade endurance shadow canary cutover and retirement"
  ],
  "tests": {
    "commands": [
      "cargo fmt --manifest-path crates/trnm-server/Cargo.toml -- --check",
      "cargo test --manifest-path crates/trnm-server/Cargo.toml --all-targets --locked",
      "cargo clippy --manifest-path crates/trnm-server/Cargo.toml --all-targets --locked -- -D warnings",
      "python3 scripts/check-rust-server-vertical-slice.py"
    ],
    "required_remote_check": "trillionnium-game-merge-gate",
    "required_live_database": true,
    "required_oracle": true
  },
  "claims": {
    "process_bootstrap_source_candidate": true,
    "bounded_http_source_candidate": true,
    "postgresql_composition_source_candidate": true,
    "grpc_source_candidate": true,
    "websocket_source_candidate": true,
    "session_security_source_candidate": true,
    "nakama_wire_compatible": false,
    "grpc_implemented": false,
    "websocket_implemented": false,
    "session_security_integrated": false,
    "database_durable": false,
    "outbox_worker_implemented": false,
    "oracle_differential_passed": false,
    "sg4_complete": false,
    "compatibility_credit": false,
    "production_ready": false,
    "public_online": false,
    "nakama_replaced": false
  }
}
