{
  "schema": "trillionnium.rust-server-vertical-slice.v1",
  "project_id": "trillionnium-game",
  "contract_version": 1,
  "status": "source-candidate",
  "crate": "crates/trnm-server",
  "binary": "trnm-server",
  "runtime_profile": "bounded-std-http-in-memory-authority",
  "configuration": {
    "environment": [
      "TRNM_SERVER_BIND",
      "TRNM_SERVER_WORKERS",
      "TRNM_SERVER_QUEUE_CAPACITY",
      "TRNM_SERVER_MAX_REQUEST_BYTES"
    ],
    "cli_commands": ["serve", "check-config", "version"],
    "bounds": {
      "worker_count_min": 1,
      "worker_count_max": 64,
      "queue_capacity_min": 1,
      "queue_capacity_max": 4096,
      "request_bytes_min": 1024,
      "request_bytes_max": 1048576,
      "header_bytes_max": 16384
    }
  },
  "implemented_routes": [
    {"method": "GET", "path": "/healthz", "classification": "liveness"},
    {"method": "GET", "path": "/readyz", "classification": "lifecycle-readiness"},
    {"method": "POST", "path": "/v1/bootstrap", "classification": "internal-fixed-binary-v1"},
    {"method": "POST", "path": "/v1/command", "classification": "internal-fixed-binary-v1"}
  ],
  "implemented_invariants": [
    "bounded accepted-connection queue",
    "fixed worker count",
    "read and write deadlines",
    "bounded header and request body",
    "explicit readiness and draining state",
    "entity revision compare-and-swap",
    "authority generation fencing",
    "command fingerprint idempotency",
    "exact duplicate receipt replay",
    "atomic in-memory state event and outbox creation"
  ],
  "required_next_adapters": [
    "authoritative PostgreSQL repository",
    "authoritative CockroachDB repository",
    "transaction retry and acknowledgement-after-commit",
    "durable outbox worker",
    "HTTP JSON v2 and gRPC adapters",
    "WebSocket JSON and protobuf adapters",
    "session/JWT verification and revocation",
    "metrics tracing signal and drain integration",
    "immutable Nakama differential"
  ],
  "tests": {
    "commands": [
      "cargo fmt --manifest-path crates/trnm-server/Cargo.toml -- --check",
      "cargo test --manifest-path crates/trnm-server/Cargo.toml --all-targets --locked",
      "cargo clippy --manifest-path crates/trnm-server/Cargo.toml --all-targets --locked -- -D warnings",
      "python3 scripts/check-rust-server-vertical-slice.py"
    ],
    "required_remote_check": "trillionnium-game-merge-gate",
    "required_live_database": false,
    "required_oracle": false
  },
  "claims": {
    "process_bootstrap_source_candidate": true,
    "bounded_http_source_candidate": true,
    "nakama_wire_compatible": false,
    "grpc_implemented": false,
    "websocket_implemented": false,
    "session_security_integrated": false,
    "database_durable": false,
    "outbox_worker_implemented": false,
    "oracle_differential_passed": false,
    "sg4_complete": false,
    "compatibility_credit": false,
    "production_ready": false,
    "public_online": false,
    "nakama_replaced": false
  }
}
