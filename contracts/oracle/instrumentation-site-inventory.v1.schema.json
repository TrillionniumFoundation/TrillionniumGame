{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trillionnium.org/contracts/oracle/instrumentation-site-inventory.v1.schema.json",
  "title": "Trillionnium Oracle instrumentation site inventory v1",
  "type": "object",
  "required": ["schema", "upstream", "site_count", "sites", "manual_contracts", "claims", "content_sha256"],
  "properties": {
    "schema": {"const": "trillionnium.oracle-instrumentation-site-inventory.v1"},
    "site_count": {"type": "integer", "minimum": 1},
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "capability", "path", "line", "column", "call", "git_blob", "source_sha256"]
      }
    },
    "manual_contracts": {"type": "array"},
    "claims": {
      "type": "object",
      "properties": {
        "patch_generated": {"const": false},
        "patch_authorized": {"const": false},
        "instrumented_image_built": {"const": false},
        "instrumented_equivalence": {"const": false},
        "sg2_complete": {"const": false}
      }
    }
  },
  "additionalProperties": true
}
