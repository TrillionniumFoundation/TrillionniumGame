{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trillionnium.org/contracts/nakama/research-session-v1/completion-ingest-request.schema.json",
  "title": "Hepta Nakama Research Session Completion Ingest V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "completion", "archive", "idempotency_key"],
  "properties": {
    "schema": {"const": "hepta.paper_raid.nakama_completion_ingest.v1"},
    "completion": {"$ref": "completion.schema.json"},
    "archive": {"type": "array", "minItems": 1, "items": {"$ref": "event.schema.json"}},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000]+$"}
  }
}
