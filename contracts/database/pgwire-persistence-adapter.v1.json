{
  "schema": "trillionnium.pgwire-persistence-adapter-contract.v1",
  "project_id": "trillionnium-game",
  "crate": "trnm-persistence-pg",
  "rust_version": "1.85.1",
  "driver": {
    "crate": "postgres",
    "version": "0.19.14",
    "mode": "synchronous-native-pgwire",
    "subprocess_wrapper_allowed": false
  },
  "profiles": ["postgresql", "cockroachdb"],
  "transaction": {
    "isolation": "serializable",
    "entity_row_lock": true,
    "entity_compare_and_swap": true,
    "receipt_before_mutation_lookup": true,
    "command_receipt_atomic": true,
    "events_atomic": true,
    "outbox_atomic": true,
    "command_outbox_order_atomic": true
  },
  "idempotency": {
    "same_command_same_fingerprint": "duplicate_receipt",
    "same_command_different_fingerprint": "already_exists_command_id_conflict",
    "post_commit_reconnect_replay": "duplicate_receipt"
  },
  "fencing": {
    "expected_revision": true,
    "authority_generation": true,
    "stale_writer_result": "aborted_resync_required"
  },
  "sqlstate": {
    "40001": "aborted_safe_immediate",
    "40P01": "aborted_safe_backoff",
    "23505": "already_exists_never",
    "23503": "failed_precondition_never",
    "23502_23514_22P02": "invalid_argument_never",
    "08xxx": "unavailable_safe_backoff"
  },
  "security": {
    "ci_no_tls_allowed": true,
    "production_no_tls_allowed": false,
    "raw_token_storage_allowed": false,
    "shell_or_psql_adapter_allowed": false
  },
  "claims": {
    "postgresql_live_adapter_verified": false,
    "cockroachdb_live_adapter_verified": false,
    "serializable_retry_loop_verified": false,
    "post_commit_response_loss_verified": false,
    "durability_under_failure_verified": false,
    "ha_verified": false,
    "production_tls_verified": false,
    "sg4_complete": false,
    "production_ready": false,
    "public_online": false
  }
}
