{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trillionnium.invalid/schemas/trnm-world-transition-v1.schema.json",
  "title": "Trillionnium World deterministic transition contract v1",
  "description": "Unsigned deterministic World request, accepted result, or typed rejection. This is not an online admission, completion-signature, Chain-finality, or settlement contract.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/accepted" },
    { "$ref": "#/$defs/rejected" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/+@-]{1,160}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canonicalPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_json", "schema_id", "sha256"],
      "properties": {
        "canonical_json": {
          "oneOf": [
            { "type": "object" },
            { "type": "array" }
          ],
          "description": "Canonical UTF-8 JSON value. Producers must use sorted keys, no insignificant whitespace, no duplicate keys, and no non-finite numbers."
        },
        "schema_id": { "$ref": "#/$defs/identifier" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "statePayload": {
      "allOf": [{ "$ref": "#/$defs/canonicalPayload" }],
      "x-trnm-max-canonical-bytes": 2097152
    },
    "commandPayload": {
      "allOf": [{ "$ref": "#/$defs/canonicalPayload" }],
      "x-trnm-max-canonical-bytes": 131072
    },
    "replayPayload": {
      "allOf": [{ "$ref": "#/$defs/canonicalPayload" }],
      "x-trnm-max-canonical-bytes": 2097152
    },
    "outcomePayload": {
      "allOf": [{ "$ref": "#/$defs/canonicalPayload" }],
      "x-trnm-max-canonical-bytes": 524288
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "payload"],
      "properties": {
        "command_id": { "$ref": "#/$defs/identifier" },
        "payload": { "$ref": "#/$defs/commandPayload" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "content_revision",
        "contract_version",
        "expected_tick",
        "previous_state",
        "ruleset_revision",
        "transition_id"
      ],
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "content_revision": { "$ref": "#/$defs/identifier" },
        "contract_version": { "const": "trnm_world_transition_v1" },
        "expected_tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "previous_state": { "$ref": "#/$defs/statePayload" },
        "ruleset_revision": { "$ref": "#/$defs/identifier" },
        "transition_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "accepted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_revision",
        "contract_version",
        "next_state",
        "next_tick",
        "outcome_material",
        "previous_state_hash",
        "replay_material",
        "request_hash",
        "ruleset_revision",
        "transition_id",
        "world_outcome_hash",
        "world_transition_hash"
      ],
      "properties": {
        "content_revision": { "$ref": "#/$defs/identifier" },
        "contract_version": { "const": "trnm_world_transition_v1" },
        "next_state": { "$ref": "#/$defs/statePayload" },
        "next_tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "outcome_material": {
          "oneOf": [
            { "$ref": "#/$defs/outcomePayload" },
            { "type": "null" }
          ]
        },
        "previous_state_hash": { "$ref": "#/$defs/sha256" },
        "replay_material": { "$ref": "#/$defs/replayPayload" },
        "request_hash": { "$ref": "#/$defs/sha256" },
        "ruleset_revision": { "$ref": "#/$defs/identifier" },
        "transition_id": { "$ref": "#/$defs/identifier" },
        "world_outcome_hash": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "world_transition_hash": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "outcome_material": { "type": "null" } },
            "required": ["outcome_material"]
          },
          "then": {
            "properties": { "world_outcome_hash": { "type": "null" } }
          },
          "else": {
            "properties": { "world_outcome_hash": { "$ref": "#/$defs/sha256" } }
          }
        }
      ]
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "invalid_contract_version",
        "invalid_request",
        "unknown_ruleset_revision",
        "unknown_content_revision",
        "payload_hash_mismatch",
        "invalid_canonical_payload",
        "forbidden_authority_surface",
        "resource_budget_exceeded",
        "invalid_command",
        "domain_rejected",
        "nondeterministic_output",
        "internal_unavailable"
      ]
    },
    "rejected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "contract_version",
        "detail",
        "request_hash",
        "retryable",
        "transition_id"
      ],
      "properties": {
        "code": { "$ref": "#/$defs/errorCode" },
        "contract_version": { "const": "trnm_world_transition_v1" },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "request_hash": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "retryable": { "type": "boolean" },
        "transition_id": { "$ref": "#/$defs/identifier" }
      }
    }
  }
}
