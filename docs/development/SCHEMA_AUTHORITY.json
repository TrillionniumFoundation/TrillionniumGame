{
  "schema": "trillionnium.schema-authority.v1",
  "project_id": "trillionnium-game",
  "plan_version": 3,
  "effective_date": "2026-08-29",
  "migration_lock": {
    "path": "migrations/MIGRATION_CHAIN.lock.json",
    "validator": "python3 scripts/check-migration-lock.py",
    "identity": "ordered path plus Git blob SHA-1 per profile; exact chain SHA-256 emitted by validation",
    "runtime_execution_credit": false
  },
  "authority": {
    "migration_root": "migrations",
    "profiles": [
      {
        "id": "postgresql",
        "path": "migrations/postgresql",
        "runtime_adapter": "crates/trnm-persistence-pg",
        "status": "production-authority-candidate",
        "evidence_required": [
          "fresh-apply",
          "catalog-introspection",
          "negative-constraints",
          "transaction-faults",
          "backup-restore",
          "pitr"
        ]
      },
      {
        "id": "cockroachdb",
        "path": "migrations/cockroachdb",
        "runtime_adapter": "crates/trnm-persistence-pg",
        "status": "production-authority-candidate",
        "evidence_required": [
          "fresh-apply",
          "catalog-introspection",
          "negative-constraints",
          "transaction-restarts",
          "leaseholder-failover",
          "backup-restore"
        ]
      }
    ],
    "metadata_table": "trnm_schema_metadata",
    "schema_version": 1,
    "identity_rule": "Every build, migration, adapter test, backup and restore artifact must record the complete ordered migration-chain SHA-256 and candidate commit/tree.",
    "postgresql_connection_fault_source_candidate": {
      "harness": "scripts/ci-postgresql-connection-faults.sh",
      "source_contract": "python3 scripts/check-postgresql-connection-faults.py",
      "covers": [
        "eighty fresh connection churn cycles",
        "role-level connection exhaustion rejection",
        "active transaction query cancellation rollback",
        "active transaction backend termination rollback",
        "statement timeout",
        "fresh connection after all injected faults"
      ],
      "accepted": false
    },
    "postgresql_pitr_source_candidate": {
      "harness": "scripts/ci-postgresql-pitr.sh",
      "source_contract": "python3 scripts/check-postgresql-pitr.py",
      "semantics": [
        "continuous WAL archive configuration",
        "physical base backup",
        "exact recovery target LSN",
        "target commit included",
        "later commit excluded",
        "automatic promotion at recovery target",
        "canonical target/restored state equality"
      ],
      "accepted": false
    },
    "postgresql_primary_failover_source_candidate": {
      "harness": "scripts/ci-postgresql-primary-failover.sh",
      "source_contract": "python3 scripts/check-postgresql-primary-failover.py",
      "semantics": [
        "streaming physical standby from pg_basebackup",
        "synchronous remote_apply acknowledged command",
        "standby replay covers acknowledged WAL LSN",
        "primary stopped before promotion",
        "canonical state equal after promotion",
        "post-promotion write succeeds"
      ],
      "accepted": false
    },
    "postgresql_recovery_barrier_source_candidate": {
      "quarantine_transaction": "scripts/postgresql-recovery-quarantine.sql",
      "harness": "scripts/ci-postgresql-recovery-barrier.sh",
      "source_contract": "python3 scripts/check-postgresql-recovery-barrier.py",
      "semantics": [
        "active leases reject quarantine",
        "ready intents exported while an exclusive table lock is held",
        "ready intents atomically become terminal quarantine records",
        "new runtime-role sessions default to read-only",
        "runtime reads remain available for verification"
      ],
      "accepted": false
    },
    "postgresql_semantic_recovery_source_candidate": {
      "harness": "scripts/ci-postgresql-semantic-recovery.sh",
      "data_snapshot": "scripts/postgresql-semantic-snapshot.sql",
      "catalog_snapshot": "scripts/postgresql-catalog-snapshot.sql",
      "source_contract": "python3 scripts/check-postgresql-semantic-recovery.py",
      "covers": [
        "repeat migration rejection without catalog drift",
        "ten critical negative-constraint probes",
        "custom-format logical backup",
        "empty-database restore",
        "exact canonical data comparison",
        "column constraint and index semantic comparison",
        "migration-lock and artifact digests"
      ],
      "accepted": false
    },
    "cockroachdb_node_failover_source_candidate": {
      "harness": "scripts/ci-cockroachdb-node-failover.sh",
      "source_contract": "python3 scripts/check-cockroachdb-node-failover.py",
      "semantics": [
        "three-node cluster and three voting replicas",
        "known range lease relocated to node one",
        "leaseholder network isolation with acknowledged-state equality",
        "quorum write during leaseholder isolation",
        "separate non-leaseholder node stop and write",
        "isolated and stopped nodes rejoin and observe committed writes"
      ],
      "accepted": false
    },
    "cockroachdb_semantic_recovery_source_candidate": {
      "harness": "scripts/ci-cockroachdb-semantic-recovery.sh",
      "data_snapshot": "scripts/cockroachdb-semantic-snapshot.sql",
      "source_contract": "python3 scripts/check-cockroachdb-semantic-recovery.py",
      "covers": [
        "repeat migration rejection without catalog drift",
        "ten critical negative-constraint probes",
        "CockroachDB native BACKUP to nodelocal",
        "empty-database RESTORE under a new database name",
        "exact canonical data comparison",
        "SHOW CREATE ALL TABLES semantic comparison",
        "migration-lock backup-tree and image digests"
      ],
      "accepted": false
    }
  },
  "non_authoritative": [
    {
      "path": "database/schema/v2",
      "classification": "design-history",
      "reason": "This family uses incompatible tenant, identifier, timestamp and table/column semantics and has not been adopted through an ADR and data migration.",
      "allowed_consumers": [
        "human-design-review",
        "historical-differential-analysis"
      ],
      "forbidden_consumers": [
        "runtime",
        "migration-runner",
        "ci-live-database",
        "backup",
        "restore",
        "release",
        "production-deployment"
      ],
      "compatibility_credit": false
    }
  ],
  "adapter_abi": {
    "crate": "crates/trnm-persistence-pg",
    "required_tables": [
      "trnm_schema_metadata",
      "trnm_entity_heads",
      "trnm_command_receipts",
      "trnm_events",
      "trnm_outbox",
      "trnm_command_outbox",
      "trnm_authority_leases",
      "trnm_session_families",
      "trnm_refresh_tokens",
      "trnm_storage_objects"
    ],
    "required_semantics": [
      "entity revision compare-and-swap",
      "authority generation fencing",
      "command fingerprint idempotency",
      "contiguous event sequence",
      "command/event/outbox atomicity",
      "outbox position ordering",
      "lease-generation fencing",
      "exact duplicate receipt replay",
      "changed receipt digest is data loss"
    ],
    "forbidden_implicit_behavior": [
      "database generated random identifiers",
      "database clock as public contract time",
      "cascade delete of durable business history",
      "shared conclusion for PostgreSQL and CockroachDB"
    ],
    "source_modules": [
      "crates/trnm-persistence-pg/src/lib.rs",
      "crates/trnm-persistence-pg/src/authority.rs",
      "crates/trnm-persistence-pg/src/session.rs",
      "crates/trnm-persistence-pg/src/storage.rs",
      "crates/trnm-persistence-pg/src/outbox.rs"
    ],
    "source_coverage_candidate": {
      "all_required_tables_referenced": true,
      "authority_lease_takeover_fences_entity_generation": true,
      "session_family_and_refresh_rotation_transactional": true,
      "storage_occ_acl_batch_transactional": true,
      "independently_accepted": false
    }
  },
  "change_control": {
    "required_for_semantic_change": [
      "ADR",
      "expand-contract plan",
      "forward-fix and rollback barrier",
      "both profile DDL and adapter update",
      "migration lock update",
      "catalog and data-semantic differential",
      "backup/restore impact",
      "evidence and status update",
      "independent database review"
    ],
    "drop_based_production_rollback_allowed": false,
    "down_migration_required_only_when_truly_reversible": true,
    "schema_design_may_supersede_authority_without_adr": false
  },
  "gap": "GAP-P0-DATA-001",
  "claim_boundary": {
    "migration_source_identity_locked": true,
    "single_node_foundation_evidence_exists": true,
    "database_durable": false,
    "migration_compatible": false,
    "rollback_proven": false,
    "pitr_proven": false,
    "ha_proven": false,
    "sg4_complete": false,
    "production_ready": false,
    "adapter_table_surface_source_candidate": true,
    "postgresql_connection_fault_source_candidate": true,
    "postgresql_pitr_source_candidate": true,
    "postgresql_primary_failover_source_candidate": true,
    "postgresql_recovery_barrier_source_candidate": true,
    "postgresql_semantic_restore_source_candidate": true,
    "cockroachdb_node_failover_source_candidate": true,
    "cockroachdb_semantic_restore_source_candidate": true
  }
}
