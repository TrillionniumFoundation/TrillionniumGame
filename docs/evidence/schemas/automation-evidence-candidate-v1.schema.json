{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trillionnium.org/schemas/automation-evidence-candidate-v1.schema.json",
  "title": "TrillionniumGame automation evidence candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_id",
    "evidence_type",
    "project_id",
    "gap_ids",
    "claim_ids",
    "candidate",
    "automation",
    "environment",
    "commands",
    "result",
    "artifacts",
    "limitations",
    "review_requirement",
    "claims"
  ],
  "properties": {
    "schema": {"const": "trillionnium.automation-evidence-candidate.v1"},
    "evidence_id": {"type": "string", "pattern": "^TG-EV-CAND-[A-Z0-9._-]{6,128}$"},
    "evidence_type": {"type": "string", "minLength": 1},
    "project_id": {"const": "trillionnium-game"},
    "gap_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^GAP-P[0-2]-[A-Z0-9-]+$"}
    },
    "claim_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree", "manifest_sha256"],
      "properties": {
        "repository": {"const": "TrillionniumFoundation/TrillionniumGame"},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "tree": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "workflow", "run_id", "run_attempt", "job", "status", "conclusion"],
      "properties": {
        "provider": {"const": "github-actions"},
        "workflow": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "pattern": "^[0-9]+$"},
        "run_attempt": {"type": "string", "pattern": "^[0-9]+$"},
        "job": {"type": "string", "minLength": 1},
        "status": {"const": "completed"},
        "conclusion": {"const": "success"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["runner_os", "runner_arch", "configuration_sha256"],
      "properties": {
        "runner_os": {"type": "string", "minLength": 1},
        "runner_arch": {"type": "string", "minLength": 1},
        "configuration_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_result", "assertions_total", "assertions_passed", "divergences"],
      "properties": {
        "source_result": {"$ref": "#/$defs/artifact"},
        "assertions_total": {"type": "integer", "minimum": 1},
        "assertions_passed": {"type": "integer", "minimum": 1},
        "divergences": {"type": "array", "items": {"type": "object"}}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "review_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent", "roles", "decision"],
      "properties": {
        "independent": {"const": true},
        "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "decision": {"const": "pending"}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automation_passed", "accepted", "gap_closed", "compatibility_credit", "production_ready"],
      "properties": {
        "automation_passed": {"const": true},
        "accepted": {"const": false},
        "gap_closed": {"const": false},
        "compatibility_credit": {"const": false},
        "production_ready": {"const": false}
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
