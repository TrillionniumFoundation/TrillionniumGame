{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trillionnium.org/schemas/oracle-observation-v1.schema.json",
  "title": "TrillionniumGame Oracle Observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "lane", "run_id", "case_id", "attempt", "input_sha256", "surfaces"],
  "properties": {
    "schema": {"const": "trillionnium.oracle-observation.v1"},
    "lane": {"enum": ["immutable", "instrumented"]},
    "run_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "input_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "surfaces": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    }
  }
}
