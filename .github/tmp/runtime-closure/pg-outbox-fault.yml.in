name: pg-outbox-fault

on:
  pull_request:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: pg-outbox-fault-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
  postgresql-outbox:
    runs-on: ubuntu-24.04
    timeout-minutes: 35
    env:
      CANDIDATE_SHA: ${{ github.event.pull_request.head.sha || github.sha }}
      TRNM_SERVER_DATABASE_URL: postgresql://trnm:trnm@127.0.0.1:55432/trnm?sslmode=disable
      TRNM_SERVER_DATABASE_PROFILE: postgresql
      TRNM_SERVER_ALLOW_PLAINTEXT_DATABASE: "1"
      TRNM_SERVER_ADMIN_TOKEN: outbox_fault_admin_token_0123456789abcdef
      TRNM_LIVE_TEST_REQUIRED: "1"
      TRNM_PG_TEST_URL: postgresql://trnm:trnm@127.0.0.1:55432/trnm?sslmode=disable
      TRNM_PG_TEST_PROFILE: postgresql
    steps:
      - name: Fetch exact candidate
        shell: bash
        run: |
          set -euo pipefail
          rm -rf "$GITHUB_WORKSPACE"
          git init "$GITHUB_WORKSPACE"
          git -C "$GITHUB_WORKSPACE" remote add origin "https://github.com/${GITHUB_REPOSITORY}.git"
          git -C "$GITHUB_WORKSPACE" fetch --no-tags --depth=1 origin "$CANDIDATE_SHA"
          git -C "$GITHUB_WORKSPACE" checkout --detach FETCH_HEAD
          test "$(git -C "$GITHUB_WORKSPACE" rev-parse HEAD)" = "$CANDIDATE_SHA"
      - name: Execute PostgreSQL outbox crash matrix
        shell: bash
        run: |
          set -euo pipefail
          trap 'docker rm -f trnm-outbox-postgres >/dev/null 2>&1 || true' EXIT
          rustup toolchain install 1.85.1 --profile minimal
          rustup override set 1.85.1
          docker run -d --name trnm-outbox-postgres \
            -e POSTGRES_USER=trnm -e POSTGRES_PASSWORD=trnm -e POSTGRES_DB=trnm \
            -p 127.0.0.1:55432:5432 __POSTGRES_IMAGE__
          for attempt in $(seq 1 90); do
            docker exec trnm-outbox-postgres pg_isready -U trnm -d trnm && break
            test "$attempt" -lt 90
            sleep 1
          done
          export TRNM_SERVER_SCHEMA_SOURCE_COMMIT="$CANDIDATE_SHA"
          cargo run --package trnm-persistence-pg --bin trnm-server --locked -- migrate
          cargo test --package trnm-persistence-pg --test outbox_runtime --locked -- --nocapture

  cockroachdb-outbox:
    runs-on: ubuntu-24.04
    timeout-minutes: 35
    env:
      CANDIDATE_SHA: ${{ github.event.pull_request.head.sha || github.sha }}
      TRNM_SERVER_DATABASE_URL: postgresql://root@127.0.0.1:26257/trnm?sslmode=disable
      TRNM_SERVER_DATABASE_PROFILE: cockroachdb
      TRNM_SERVER_ALLOW_PLAINTEXT_DATABASE: "1"
      TRNM_SERVER_ADMIN_TOKEN: outbox_fault_admin_token_0123456789abcdef
      TRNM_LIVE_TEST_REQUIRED: "1"
      TRNM_PG_TEST_URL: postgresql://root@127.0.0.1:26257/trnm?sslmode=disable
      TRNM_PG_TEST_PROFILE: cockroachdb
    steps:
      - name: Fetch exact candidate
        shell: bash
        run: |
          set -euo pipefail
          rm -rf "$GITHUB_WORKSPACE"
          git init "$GITHUB_WORKSPACE"
          git -C "$GITHUB_WORKSPACE" remote add origin "https://github.com/${GITHUB_REPOSITORY}.git"
          git -C "$GITHUB_WORKSPACE" fetch --no-tags --depth=1 origin "$CANDIDATE_SHA"
          git -C "$GITHUB_WORKSPACE" checkout --detach FETCH_HEAD
          test "$(git -C "$GITHUB_WORKSPACE" rev-parse HEAD)" = "$CANDIDATE_SHA"
      - name: Execute CockroachDB outbox crash matrix
        shell: bash
        run: |
          set -euo pipefail
          trap 'docker rm -f trnm-outbox-cockroach >/dev/null 2>&1 || true' EXIT
          rustup toolchain install 1.85.1 --profile minimal
          rustup override set 1.85.1
          docker run -d --name trnm-outbox-cockroach \
            -p 127.0.0.1:26257:26257 __COCKROACH_IMAGE__ \
            start-single-node --insecure --listen-addr=0.0.0.0:26257 \
            --http-addr=0.0.0.0:8080
          for attempt in $(seq 1 90); do
            docker exec trnm-outbox-cockroach cockroach sql --insecure \
              --host=127.0.0.1:26257 -e 'SELECT 1' >/dev/null 2>&1 && break
            test "$attempt" -lt 90
            sleep 1
          done
          docker exec trnm-outbox-cockroach cockroach sql --insecure \
            --host=127.0.0.1:26257 -e 'CREATE DATABASE IF NOT EXISTS trnm'
          export TRNM_SERVER_SCHEMA_SOURCE_COMMIT="$CANDIDATE_SHA"
          cargo run --package trnm-persistence-pg --bin trnm-server --locked -- migrate
          cargo test --package trnm-persistence-pg --test outbox_runtime --locked -- --nocapture
